<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device transfer for API 31+ (decision D4): the flight database only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="duty_tracker_db" />
        <include domain="database" path="duty_tracker_db-wal" />
        <include domain="database" path="duty_tracker_db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="duty_tracker_db" />
        <include domain="database" path="duty_tracker_db-wal" />
        <include domain="database" path="duty_tracker_db-shm" />
    </device-transfer>
</data-extraction-rules>
